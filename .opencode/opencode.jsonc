    // Playwright browser tools (2026-10-27 re-spell): the 23 bare
    // `playwright_browser_*` actions that stood here matched nothing —
    // permission actions name the normalized <server>_<tool> id, and the
    // real servers are `dev-playwright` (this file) and `global-playwright`
    // (machine fleet). The two prefix allows replace them; newly covered
    // vs the old list: browser_emulate_media, browser_find.
    {
      "action": "dev-playwright_browser_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "global-playwright_browser_*",
      "resource": "*",
      "effect": "allow"
    },
