{
  // Project-level OpenCode config for the SpencersLab repo: the "dev" half
  // of the agent tool config. Merges over the global config (project entries
  // win; non-conflicting global settings are preserved).
  //
  // MCP fleet split (2026-10-25): only the dev-cluster servers
  // (mcp.dev.scifi.farm) live here. The regular fleet is in the global
  // config, hard-linked into this repo as .opencode/opencode-global.jsonc
  // — add or change regular servers there (or at
  // ~/.config/opencode/opencode.json), never by duplicating them here.
  //
  // LLM providers (gpu-ai / gpu-moe, with per-model limit.context fixing
  // OpenCode's 200k fallback for uncataloged models) live in the GLOBAL
  // config — machine-wide endpoints, used from other projects too.
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "readonly-dev-kubernetes": {
        "type": "remote",
        "url": "https://mcp.dev.scifi.farm/kubernetes-readonly/mcp",
        "disabled": false,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "admin-dev-kubernetes": {
        "type": "remote",
        "url": "https://mcp.dev.scifi.farm/kubernetes-admin/mcp",
        "disabled": true,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      // Dev-cluster utility fleet (ticket 2026-10-feat-dev-mcp-fleet): tier-less
      // by user choice, so pipeline agents need the `dev*` allow rule in
      // .rulesync/subagents/ — unlisted tier-less names fall through to ask.
      "dev-playwright": {
        "type": "remote",
        "url": "https://mcp.dev.scifi.farm/playwright/mcp",
        "disabled": false,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "dev-renovate": {
        "type": "remote",
        "url": "https://mcp.dev.scifi.farm/renovate/mcp",
        "disabled": false,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "dev-searxng": {
        "type": "remote",
        "url": "https://mcp.dev.scifi.farm/searxng/mcp",
        "disabled": false,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "dev-boards": {
        "type": "remote",
        "url": "https://mcp.dev.scifi.farm/boards/mcp",
        "disabled": false,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      }
    }
  },
  "permissions": [
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*>*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "printenv *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "whoami *",
      "effect": "allow"
    },
    {
      "action": "shell",
