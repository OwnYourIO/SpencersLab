  "disabled_providers": [
    "kilo",
    "llama",
    "opencode",
    "spencerslab"
  ],
  "default_agent": "plan",
  "skills": [
    "/home/coder/CuratedForest.com/content/tech/home-assistant",
    "./.agents/skills",
    "skills/"
  ]
