{
  // Project-level OpenCode config for the SpencersLab repo.
  // 2026-10-13: agent-config.jsonc was removed from the repo; the
  // global configs (~/.config/opencode/opencode.json and
  // ~/.config/kilo/kilo.jsonc) are now real machine-local files.
  // This file is the version-controlled source for what this project
  // needs beyond the globals: lab MCP servers, permissions, skills
  // and the default agent. It merges over the global config
  // (project entries win).
  //
  // LLM providers (gpu-ai / gpu-moe, with per-model limit.context
  // fixing OpenCode's 200k fallback for uncataloged models) live in
  // the GLOBAL config, not here — they're machine-wide endpoints,
  // used from other projects too.
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "global-playwright": {
        "type": "remote",
        "url": "http://mcp-mcp-playwright-headless.default:8931/mcp",
        "disabled": false,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "readonly-global-homeassistant": {
        "type": "remote",
        "url": "http://mcp-mcp-homeassistant-readonly-headless.default:8080/mcp",
