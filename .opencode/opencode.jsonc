{
  // Project-level OpenCode config for the SpencersLab repo: the "dev" half
  // of the agent tool config. Merges over the machine-global config (project
  // entries win; non-conflicting global settings are preserved), so this
  // repo also sees the regular MCP fleet defined globally.
  //
  // Version-controlled here: the dev-cluster MCP servers
  // (mcp.dev.scifi.farm) and the gpu-ai provider (this repo's llama
  // endpoint, llama.spencerslab.com). The regular MCP fleet, the gpu-moe
  // provider, agents and global permissions live in the machine-local
  // global config (~/.config/opencode/opencode.json, NOT version-
  // controlled); ~/.config/kilo/kilo.jsonc keeps its own older fleet copy.
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "readonly-dev-kubernetes": {
        "type": "remote",
        "url": "https://mcp.dev.scifi.farm/kubernetes-readonly/mcp",
        "disabled": false,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "admin-dev-kubernetes": {
        "type": "remote",
        "url": "https://mcp.dev.scifi.farm/kubernetes-admin/mcp",
        "disabled": true,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      // Dev-cluster utility fleet (ticket 2026-10-feat-dev-mcp-fleet): tier-less
      // by user choice, so pipeline agents need the `dev*` allow rule in
      // .rulesync/subagents/ — unlisted tier-less names fall through to ask.
      "dev-playwright": {
        "type": "remote",
        "url": "https://mcp.dev.scifi.farm/playwright/mcp",
        "disabled": false,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "dev-renovate": {
        "type": "remote",
        "url": "https://mcp.dev.scifi.farm/renovate/mcp",
        "disabled": false,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "dev-searxng": {
        "type": "remote",
        "url": "https://mcp.dev.scifi.farm/searxng/mcp",
        "disabled": false,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      },
      "dev-boards": {
        "type": "remote",
        "url": "https://mcp.dev.scifi.farm/boards/mcp",
        "disabled": false,
        "timeout": {
          "catalog": 60000,
          "execution": 60000
        }
      }
    }
  },
  "providers": {
    "gpu-ai": {
      "name": "GPU-AI",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://llama.spencerslab.com/v1",
        // Deep-context prefills exceed OpenCode's 300s default
        // headerTimeout (llama-server sends no headers until prefill
        // ends; 60k+ tokens takes ~5min at ~220 t/s -> 499 aborts).
        // 2h header budget; 2h between-chunk stall guard (fires
        // -> auto-retry on genuinely dead streams). Raised from
        // 60min/15min on 2026-10-15: dense-27B cold prefills of 90k+
        // tokens can take 10min+, and -np 1 queuing delays headers
        // further (see 2026-10-15-debug-gpu-ai-opencode-499 plan).
        "headerTimeout": 7200000,
        "chunkTimeout": 7200000
      },
      "models": {
        "home-3b-v3": {
          "modelID": "home-3b-v3",
          "name": "Home 3B v3 (Q4_K_M) - CPU",
          "limit": {
            "context": 8192
          }
        },
        "home-3b-v3-gpu": {
          "modelID": "home-3b-v3-gpu",
          "name": "Home 3B v3 (Q8_0) - GPU",
          "limit": {
            "context": 8192
          }
        },
        "kat-coder-q4": {
          "modelID": "kat-coder-q4",
          "name": "KAT Coder V2.5 Dev (Q4_K_M)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144
          }
        },
        "kat-coder-q6": {
