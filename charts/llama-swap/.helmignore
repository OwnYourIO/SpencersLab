# Tests run from the source checkout, not from the installed chart.
tests/
scripts/__pycache__/
.pytest_cache/
*.pyc
# The vendored b10015 converter closure (~750 KiB) stays in git as the source
# of truth for the converter-source.json pins and the CI contract tests, but
# is NOT part of the packaged chart: configmap-tools.yaml embeds only
# llama_tools.py + converter-source.json (embedding the closure broke ArgoCD
# client-side apply — the last-applied-configuration annotation is capped at
# 256 KiB). `prepare` fetches the pinned files at runtime instead.
scripts/conversion/
scripts/gguf-py/
scripts/convert_lora_to_gguf.py
