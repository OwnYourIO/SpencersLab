{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Denver",
  "ignoreTests": true,
  "labels": ["dependencies"],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "semanticCommits": "disabled",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Plain image: lines in chart/service templates (ToolHive MCPServer specs, raw Deployments). Helm-templated and commented lines don't match; untagged/latest images yield no updates.",
      "managerFilePatterns": [
        "/(^|/)charts/[^/]+/templates/[^/]+\\.ya?ml$/",
        "/(^|/)services/[^/]+/[^/]+/templates/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(^|\\n)[ \\t]*image:[ \\t]+(?<depName>[A-Za-z0-9._/-]+):(?<currentValue>[A-Za-z0-9._-]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Updates for k3s.",
      "customType": "regex",
      "managerFilePatterns": [
        "/k3s-version\\.yaml$/"
      ],
      "matchStrings": [
        "version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+\\+k3s\\d+)"
      ],
      "depNameTemplate": "rancher/k3s",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>v\\d+\\.\\d+\\.\\d+\\+k3s\\d+)$",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    },
    {
      "description": "Update Charts - explicit chart field",
      "customType": "regex",
      "managerFilePatterns": [
        "/values\\.yaml$/"
      ],
      "matchStrings": [
        "chart:\\s*(?<depName>[a-zA-Z0-9_-]+)\\s*\\n\\s+#?version:\\s*(?<currentValue>[\\d.]+)\\s*\\n\\s+repository:\\s*(?<registryUrl>\\S+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "description": "Update Charts - key as chart name",
      "customType": "regex",
      "managerFilePatterns": [
        "/values\\.yaml$/"
      ],
      "matchStrings": [
        "(?<depName>[a-zA-Z0-9_-]+):\\s*\\n\\s+#?\\s?version:\\s*(?<currentValue>[\\d.]+)\\s*\\n\\s+repository:\\s*(?<registryUrl>\\S+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Update Traefik's plugins when found in values.yaml files",
      "managerFilePatterns": [
        "/values\\.ya?ml$/"
      ],
      "matchStrings": [
        "moduleName:\\s*\"github\\.com/(?<packageName>[^\"]+)\"[^\"]*version:\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "{{packageName}}"
    },
    {
      "customType": "regex",
      "description": "Update Grafana dashboards from grafana.com",
      "managerFilePatterns": [
        "/\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*depName=\"(?<depName>[^\"]+)\"\\s+gnetId:\\s*(?<packageName>\\d+)\\s+revision:\\s*(?<currentValue>\\d+)"
      ],
      "datasourceTemplate": "custom.grafana-dashboards",
      "versioningTemplate": "regex:^(?<major>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update baseChartVersion with inline renovate comment",
      "managerFilePatterns": [
        "/appset\\.ya?ml$/"
      ],
      "matchStrings": [
        "\\s*#*\\s*appName:\\s*(?<depName>[^\\s#]+)\\s*#\\s*renovate:\\s*datasource=helm\\s+registryUrl=(?<registryUrl>\\S+)\\s*\\n\\s*baseChartVersion:\\s*(?<currentValue>[\\d.]+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Pin git-installed Python pkgs in Dockerfiles via renovate comment on the line above an ARG line. Tracks GitHub tags/commits/releases.",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>github-tags|github-releases|git-refs)\\s+depName=(?<depName>[^\\s]+)\\s*\\nARG\\s+\\w+=(?<currentValue>[a-f0-9]{7,40}|v?\\d[\\w.+-]*)"
      ]
    },
    {
      "customType": "regex",
      "description": "Override changelog/source URL for Helm chart deps via inline '# changelog:' or '# sourceUrl:' comment on the line after the repository line. Lets us point Renovate at upstream GitHub releases when the helm index.yaml lacks a sources field.",
      "managerFilePatterns": [
        "/Chart\\.ya?ml$/",
        "/values\\.ya?ml$/"
      ],
      "matchStrings": [
        "-\\s*name:\\s*(?<depName>[a-zA-Z0-9_-]+)\\s*\\n\\s*version:\\s*(?<currentValue>[\\d.]+)\\s*\\n\\s*repository:\\s*(?<registryUrl>\\S+)\\s*\\n\\s*#\\s*(changelog|sourceUrl):\\s*(?<sourceUrl>\\S+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Pinned tools in containers/*/Dockerfile: the \"# renovate:\" comment line directly above an ARG line. The datasource capture is narrowed to node-version|golang-version|forgejo-releases|npm so the github-tags/github-releases/git-refs ARG lines stay with the existing git-pin manager instead of double-matching it (duplicate-dependency warnings).",
      "managerFilePatterns": [
        "/(^|/)containers/[^/]+/Dockerfile$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>node-version|golang-version|forgejo-releases|npm)\\s+(?:registryUrl=(?<registryUrl>\\S+)\\s+)?depName=(?<depName>\\S+)\\s*\\nARG\\s+\\w+=(?<currentValue>\\S+)"
      ]
    }
  ],
  "customDatasources": {
    "grafana-dashboards": {
      "defaultRegistryUrlTemplate": "https://grafana.com/api/dashboards/{{packageName}}",
      "format": "json",
      "transformTemplates": [
        "{\"releases\":[{\"version\": $string(revision)}]}"
      ]
    }
  },
  "packageRules": [
    {
      "description": "Update base Chart nightly",
      "matchFileNames": [
        "chart/base"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeSchedule": [
        "* 1-6 * * *"
      ]
    },
    {
      "description": "Auto Update Proxies",
      "matchFileNames": [
        "service/proxy"
      ],
      "matchPackageNames": [
        "base",
        "monitoring-agent",
        "external-secrets-bitwarden"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeSchedule": [
        "* 1-6 * * *"
      ]
    },
    {
      "description": "Internet facing services.",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automergeSchedule": [
        "* 1-6 * * *"
      ],
      "matchPackageNames": [
        "traefik",
        "keycloakopenid",
        "keycloakx",
        "ghcr.io/linuxserver/openssh-server",
        "crowdsec"
      ],
      "lockFileMaintenance": {
        "enabled": true
      },
      "automerge": true
    },
    {
      "description": "Non-critical services",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automergeSchedule": [
        "* 1-6 * * 2"
      ],
      "matchPackageNames": [
        "argo-cd",
        "org.keycloak:keycloak-parent",
        "wekan",
        "jellyseerr",
        "lidarr",
        "radarr",
        "readarr",
        "sonarr",
        "ghcr.io/home-operations/prowlarr",
        "ghcr.io/advplyr/audiobookshelf",
        "ghcr.io/kieraneglin/pinchflat",
        "ghcr.io/onedr0p/qbittorrent",
        "ghcr.io/music-assistant/server",
        "toertel/logitech-media-server",
        "alpine"
      ],
      "lockFileMaintenance": {
        "enabled": true
      },
      "automerge": true
    },
    {
      "description": "Hold the helm v3 line: ArgoCD renders this repo's charts with helm v3, so v4 updates are held back until that changes. The pattern is slash-wrapped: a bare ^v3. is not a valid semver range, so renovate would error this dep at lookup with no updates.",
      "matchPackageNames": [
        "helm/helm"
      ],
      "allowedVersions": "/^v3\\./"
    },
    {
      "description": "Hold kubectl to the lab cluster minor (k3s v1.36.x per charts/base/templates/k3s-version.yaml); a cluster minor upgrade must bump this pattern together with the Dockerfile pin. The pattern is slash-wrapped: a bare ^v1.36. is not a valid semver range, so renovate would error this dep at lookup with no updates.",
      "matchPackageNames": [
        "kubernetes/kubernetes"
      ],
      "allowedVersions": "/^v1\\.36\\./"
    },
    {
      "description": "Hold ghcr.io/containers/kubernetes-mcp-server on the TOML config surface (>= v0.0.68): upstream PR #1423 removed every runtime CLI flag in v0.0.68, so any bump crossing that boundary breaks the --config args charts/hivetools ships on every cluster (2026-10-25 crashloop incident, PR #704). Semver tag bumps on the TOML side keep flowing. Floor is a semver range, not a regex: docker versioning strips the v prefix, node-semver accepts the v-prefixed comparator.",
      "matchPackageNames": [
        "ghcr.io/containers/kubernetes-mcp-server"
      ],
      "allowedVersions": ">= v0.0.68"
    },
    {
      "description": "Scope the llama-swap image pin (extracted by the built-in helm-values manager from the repository:/tag: pair in charts/llama-swap/values.yaml) to llama-swap's release-versioned unified-vulkan-<N> tag family. Under the manager's default docker versioning the tag never parses as semver, so no update was ever proposed (the unified-vulkan-262 in-place rebuild of 2026-10-25, which crash-looped the gpu box, passed through unnoticed). A non-slash-wrapped regex would be an invalid semver range, hence versioning (not allowedVersions).",
      "matchPackageNames": [
        "ghcr.io/mostlygeek/llama-swap"
      ],
      "matchDatasources": [
        "docker"
      ],
      "versioning": "regex:^unified-vulkan-(?<major>\\d+)$"
    }
  ]
}