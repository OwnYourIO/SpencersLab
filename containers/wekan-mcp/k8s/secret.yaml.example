# WeKan credentials for the wekan-mcp server.
#
# DO NOT COMMIT THIS FILE WITH REAL VALUES. Options for real deployments:
#   1. Apply this manifest once from a workstation, then delete it locally:
#        kubectl create secret generic wekan-creds \
#          -n toolhive-system \
#          --from-literal=token='<YOUR_WEKAN_BEARER_TOKEN>'
#   2. Use sealed-secrets, external-secrets-operator, or Vault CSI to
#      inject the token from your existing secret manager instead of a
#      plain Kubernetes Secret.
#
# The MCPServer resource references this by name (wekan-creds) and key (token),
# and mounts it into the pod as the env var WEKAN_TOKEN.

apiVersion: v1
kind: Secret
metadata:
  name: wekan-creds
  namespace: toolhive-system
type: Opaque
stringData:
  # Replace with a bearer token obtained by POSTing JSON to /users/login
  # on the WeKan server once. See references/rest-api-overview.md.
  token: "REPLACE_ME_WITH_WEKAN_BEARER_TOKEN"
