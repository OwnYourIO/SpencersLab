# cf-86 C09 carry — Ornith-1.5-122B on Strata's q36 (qwen35moe) path at tag v0.2.9.
#
# Two constants-only hunks, generated as a real diff against the v0.2.9 tree and
# vendored from the community record on upstream issue #3574 (RESEARCH R5
# [C6][C10] re-verified every line at the tag).  #3574 is closed not_planned —
# maintainer, 2026-10-22: "Ornith 122B is not in the plan for the next release,
# but we want to add it later" — so this carry has no upstream home: RE-WATCH
# #3574 and #4460, and DROP this file at the next pin bump as soon as upstream
# ships the support first-class (a local duplicate past that point hides an
# upstream fix instead of recording a gap).
#
# Hunk 1 (#3574, wall 1): the CPU expert pool's activation buffer.  Ornith's FF
# is 1024, so a routed down activation is Q8_K(1024) = 4 x 292 = 1,168 B, and
# native_expert.cpp refuses the model ("activation larger than the pool's
# buffers").  The activation side already fits: Q8_K(3072) = 12 x 292 = 3,504.
#
# Hunk 2 (#3574, wall 2): the down-format instantiation list.  unsloth's
# UD-Q4_K_XL ladder routes Q4_K (fmt 12) downs (live GGUF tensor census) while
# GU_FMTS already instantiates 12, so exactly one format is missing per branch;
# q36 has no fallback for an unsupported expert pair (hard load refusal).  Both
# branches move because setup.py compiles with -DSTRATA_Q6K_EXPERTS=ON and the
# bare branch must not drift into a tree that cannot load the model.
#
# Applied in the Dockerfile's strata-src stage before .git is removed, and
# re-proved in the verify layer (git apply --check --reverse + the two constant
# greps): CI never compiles HIP, so those greps are the only pre-merge evidence
# that the shipped tree is the patched tree.  A bump that moves these lines
# fails the BUILD, not the pod.

diff --git a/include/strata/kernels/cpu/native_expert.hpp b/include/strata/kernels/cpu/native_expert.hpp
index 2d2e43e..fe22b46 100644
--- a/include/strata/kernels/cpu/native_expert.hpp
+++ b/include/strata/kernels/cpu/native_expert.hpp
@@ -15,8 +15,10 @@ namespace strata::kernels::cpu {
 
 /// Bytes of the largest quantized activation any native layer uses (2560 values as Q8_K: 10 x 292).
 inline constexpr size_t kNativeActBytes = 4096;
-/// Bytes of the largest quantized down activation (640 values as Q8_0: 20 x 34, or Q8_K 3 x 292).
-inline constexpr size_t kNativeHBytes = 1024;
+/// Bytes of the largest quantized down activation.  Sized for Flash-Next's FF 640 (Q8_0: 20 x 34,
+/// or Q8_K 3 x 292); an Ornith-1.5-122B FF 1024 down activation is Q8_K 4 x 292 = 1,168 B, so the
+/// pool rounds this buffer up to 2 KiB (carry for upstream #3574, closed not_planned).
+inline constexpr size_t kNativeHBytes = 2048;
 
 /// Arithmetic fixed for one pool batch. WindowInvariant preserves the legacy singleton result at every width.
 enum class NativeArithmetic { Default, WindowInvariant };
